<Window x:Class="OpenCodeStudio.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="820" Height="680"
        MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="titleText" Grid.Row="0" Margin="24,20,24,12" Text="Settings"
                   FontSize="22" FontWeight="SemiBold" Foreground="#f1f1f1" />

        <TabControl Grid.Row="1" Margin="24,0,24,0" Background="#252526" BorderBrush="#3a3a3a">
            <TabItem Header="Import">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="6" Background="#252526"
                            BorderBrush="#3a3a3a" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                            <StackPanel x:Name="sourcesPanel" />
                        </ScrollViewer>
                    </Border>

                    <Button x:Name="browseButton" Grid.Row="1" Content="Add folder..." Padding="14,8"
                            Margin="0,12,0,0" HorizontalAlignment="Left" Click="OnBrowseClick" />
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <Border x:Name="usageCard" Margin="0,0,0,12" CornerRadius="6"
                                Background="#2a2440" BorderBrush="#7C3AED" BorderThickness="1" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Usage &amp; limits overlay" FontSize="14" FontWeight="SemiBold" Foreground="#d7c4ff" />
                                <CheckBox x:Name="usageCheck" Margin="0,8,0,0" Foreground="#e8e0ff" IsChecked="True"
                                          Content="Show usage strip and limits in the OpenCode panel" />
                                <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#b9a8e0" TextWrapping="Wrap"
                                           Text="Adds a live strip (cost today and, with an OpenCode Go subscription, remaining day/week/month limits) to the OpenCode web UI. You can change this later in Tools &#8594; Options." />
                            </StackPanel>
                        </Border>

                        <Border x:Name="v2Card" CornerRadius="6"
                                Background="#252526" BorderBrush="#3a3a3a" BorderThickness="1" Padding="14">
                            <StackPanel>
                                <TextBlock Text="OpenCode version" FontSize="14" FontWeight="SemiBold" Foreground="#f1f1f1" />
                                <CheckBox x:Name="v2Check" Margin="0,8,0,0" Foreground="#e6e6e6"
                                          Content="Use opencode v2.x (preview) version" />
                                <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#a0a0a0" TextWrapping="Wrap"
                                           Text="When enabled, OpenCode Studio prefers the OpenCode 2 beta binary (opencode2). Leave it off to use stable opencode v1. Both can be installed side by side. Change it later in Tools &#8594; Options." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="24,12,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="statusText" Grid.Column="0" VerticalAlignment="Center"
                       FontSize="12" Foreground="#9a9a9a" TextWrapping="Wrap" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="skipButton" Content="Skip" Padding="14,8" Margin="0,0,8,0"
                        Click="OnSkipClick" />
                <Button x:Name="importButton" Content="Save selected" Padding="18,8"
                        FontWeight="SemiBold" Click="OnImportClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
