<Window x:Class="OpenCodeStudio.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to OpenCode Studio"
        Width="820" Height="680"
        MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,12">
            <TextBlock x:Name="titleText" Text="Welcome to OpenCode Studio"
                       FontSize="22" FontWeight="SemiBold" Foreground="#f1f1f1" />
            <TextBlock x:Name="subtitleText" Margin="0,6,0,0" TextWrapping="Wrap"
                       FontSize="12" Foreground="#a0a0a0"
                       Text="OpenCode Studio runs the OpenCode web UI inside Visual Studio. We detected your existing OpenCode data below. Choose what to bring in, or just continue - nothing is changed unless you click Import." />
        </StackPanel>

        <Border Grid.Row="1" Margin="24,0,24,0" CornerRadius="6" Background="#252526"
                BorderBrush="#3a3a3a" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel x:Name="sourcesPanel" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="24,12,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="statusText" Grid.Column="0" VerticalAlignment="Center"
                       FontSize="12" Foreground="#9a9a9a" TextWrapping="Wrap" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="browseButton" Content="Add folder..." Padding="14,8" Margin="0,0,8,0"
                        Click="OnBrowseClick" />
                <Button x:Name="skipButton" Content="Skip" Padding="14,8" Margin="0,0,8,0"
                        Click="OnSkipClick" />
                <Button x:Name="importButton" Content="Import selected" Padding="18,8"
                        FontWeight="SemiBold" Click="OnImportClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
